# Docker network deps
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-dummy=y

# Raid456 dependency
CONFIG_PACKAGE_kmod-lib-raid6=y

# NVMe/SATA
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-nvme-core=y
CONFIG_PACKAGE_kmod-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_smartmontools=y

# PWM fan and thermal
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-pwm-rockchip=y
CONFIG_PACKAGE_kmod-thermal=y

# F2FS kernel module
CONFIG_PACKAGE_kmod-fs-f2fs=y

# SD card / eMMC storage controller
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y

# USB controller
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-roles=y
CONFIG_PACKAGE_kmod-usb-phy-nop=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# GPIO / pinmux / regulator for LED, button, fan
CONFIG_PACKAGE_kmod-pinctrl-rockchip=y
CONFIG_PACKAGE_kmod-gpio-pwm=y
CONFIG_PACKAGE_kmod-regulator-fixed=y
CONFIG_PACKAGE_kmod-regulator-gpio=y

# R5S onboard RTC (PCF8563)
CONFIG_PACKAGE_kmod-rtc-pcf8563=y

# Kernel cgroup for Docker resource limits
CONFIG_KERNEL_FREEZER=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_RT_GROUP_SCHED=y

# User namespaces for Docker isolation
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_NET_NS=y

# Samba / NAS efficiency
CONFIG_KERNEL_FANOTIFY=y
CONFIG_KERNEL_SWAP=y

# 2.5G network performance
CONFIG_KERNEL_NET_L3_MASTER_DEV=y
CONFIG_KERNEL_PAGE_POOL=y

# Kernel keys (WireGuard, IPsec, fscrypt)
CONFIG_KERNEL_KEYS=y
CONFIG_PACKAGE_kmod-keys-encrypted=y
CONFIG_PACKAGE_kmod-keys-trusted=y

# Coredump for debugging
CONFIG_KERNEL_COREDUMP=y
CONFIG_KERNEL_ELF_CORE=y

# Bootloader / TF-A (needed when building SD image)
CONFIG_PACKAGE_u-boot-nanopi-r5s-rk3568=y
CONFIG_PACKAGE_trusted-firmware-a-rk3568=y
CONFIG_PACKAGE_trusted-firmware-a-rk3568-tpl-e25=y

