name: Build ImmortalWrt for NanoPi R5S

on:
  watch:
    types: started
  workflow_dispatch:
    inputs:
      replace_existing:
        description: 'Replace existing release tag (overwrite)'
        required: false
        default: 'true'
        type: choice
        options:
          - 'false'
          - 'true'

env:
  AUTO_REPLACE_TAG: 'false'
  IMMORTALWRT_BRANCH: 'openwrt-25.12'
  IMMORTALWRT_REPO: 'https://github.com/immortalwrt/immortalwrt.git'
  FLAVOR: 'r5s'
  TARGET_OS: 'friendlywrt25'
  MODEL_NAME: 'R5S-R5C-Series'
  FRIENDLY_VER: '25.12'
  GOPROXY: 'https://goproxy.cn,direct'
  GOFLAGS: '-mod=mod'
  GOMODCACHE: '/tmp/go-mod-cache'
  CCACHE_DIR: '/home/runner/.ccache'
  CCACHE_COMPRESS: 'true'
  CCACHE_MAXSIZE: '3G'
  ROOTFS_PARTSIZE: '2048'
  ENABLE_DOCKER: 'true'
  DOCKER_BOOTARGS: 'cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1'
  CACHE_VERSION: 'v6'

jobs:
  prepare_release:
    runs-on: ubuntu-22.04
    if: github.event.repository.owner.id == github.event.sender.id
    outputs:
      release_tag: ${{ steps.release_tag.outputs.tag }}
    steps:
      - name: Generate unique release tag
        id: release_tag
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          BASE_TAG="ImmortalWrt-R5S-$(date +%Y-%m-%d)"
          FORCE_BASE=false
          if [ "${{ github.event_name }}" == "workflow_dispatch" ] && [ "${{ github.event.inputs.replace_existing }}" == "true" ]; then
            FORCE_BASE=true
          elif [ "${{ github.event_name }}" == "watch" ] && [ "${{ env.AUTO_REPLACE_TAG }}" == "true" ]; then
            FORCE_BASE=true
          fi

          if [ "$FORCE_BASE" = "true" ]; then
            EXISTING_TAGS=$(gh release list --limit 100 --repo "$GITHUB_REPOSITORY" --json tagName --jq '.[].tagName' | grep -E "^${BASE_TAG}(-[0-9]+)?$" || true)
            for tag in $EXISTING_TAGS; do
              gh release delete "$tag" --yes --repo "$GITHUB_REPOSITORY" || true
              git push origin --delete "refs/tags/$tag" || true
            done
            TAG="$BASE_TAG"
          else
            EXISTING_TAGS=$(gh release list --limit 100 --repo "$GITHUB_REPOSITORY" --json tagName --jq '.[].tagName' | grep -E "^${BASE_TAG}(-[0-9]+)?$" || true)
            if [ -z "$EXISTING_TAGS" ]; then
              TAG="$BASE_TAG"
            else
              MAX_NUM=0
              for t in $EXISTING_TAGS; do
                if [[ $t =~ ^${BASE_TAG}-([0-9]+)$ ]]; then
                  NUM=${BASH_REMATCH[1]}
                  [ $NUM -gt $MAX_NUM ] && MAX_NUM=$NUM
                fi
              done
              TAG="${BASE_TAG}-$((MAX_NUM + 1))"
            fi
          fi
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"
          echo "Release tag: $TAG"

      - name: Create or update release
        uses: softprops/action-gh-release@v1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: ${{ steps.release_tag.outputs.tag }}
          draft: false
          prerelease: false
          allow_updates: true
          overwrite: true

  build:
    needs: prepare_release
    runs-on: ubuntu-22.04
    if: github.event.repository.owner.id == github.event.sender.id
    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: Reclaim disk space
      run: |
        sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
                    /opt/hostedtoolcache/CodeQL /usr/local/share/boost \
                    /usr/share/swift /usr/local/.ghcup /opt/az || true
        sudo apt-get clean
        df -h /

    - name: Add swap
      run: |
        sudo swapoff -a || true
        sudo rm -f /swapfile
        sudo fallocate -l 4G /swapfile
        sudo chmod 600 /swapfile
        sudo mkswap /swapfile > /dev/null
        sudo swapon /swapfile
        free -h

    - name: Initialization environment
      env:
        DEBIAN_FRONTEND: noninteractive
      run: |
        sudo apt-get update -qq
        sudo apt-get install -y -qq \
          build-essential ccache ecj fastjar file g++ gawk gettext git \
          java-propose-classpath libelf-dev libncurses5-dev libncursesw5-dev \
          libssl-dev python3 python3-dev python3-distutils python3-setuptools \
          python3-pip python3-venv python3-pyelftools rsync subversion swig time \
          xsltproc zlib1g-dev \
          bison flex libtool libtool-bin pkg-config \
          libgmp-dev libmpc-dev libmpfr-dev \
          gperf patch quilt cpio \
          liblzma-dev libbz2-dev \
          device-tree-compiler u-boot-tools \
          bzip2 xz-utils zip unzip wget curl \
          autoconf automake autopoint texinfo help2man \
          aria2 bc whiptail mercurial lib32stdc++6 \
          android-sdk-libsparse-utils e2fsprogs parted dosfstools mtools lz4
        sudo update-alternatives --install /usr/bin/python python /usr/bin/python3 1 || true
        python3 -c "import elftools" 2>/dev/null || pip3 install --quiet pyelftools
        mkdir -p ./artifact
        echo "CPU cores: $(nproc)"

    - name: Prepare workspace and cache key
      run: |
        mkdir -p project
        cd project
        git clone --depth 1 -b ${{ env.IMMORTALWRT_BRANCH }} \
          ${{ env.IMMORTALWRT_REPO }} friendlywrt > /dev/null 2>&1
        cd friendlywrt
        git log -1 --oneline
        grep -E "KERNEL_(PATCHVER|TESTING_PATCHVER)" target/linux/rockchip/Makefile 2>/dev/null || true
        ./scripts/feeds update -a > /dev/null 2>&1 || ./scripts/feeds update -a
        ./scripts/feeds install -a > /dev/null 2>&1
        cd ..
        mkdir -p configs/rockchip
        touch configs/rockchip/01-nanopi

        # 快照关键文件供 hashFiles() 计算缓存 key
        mkdir -p "$GITHUB_WORKSPACE/.cache-key"
        CK="$GITHUB_WORKSPACE/.cache-key"
        cp friendlywrt/target/linux/rockchip/Makefile "$CK/rockchip.Makefile" 2>/dev/null || true
        cp friendlywrt/toolchain/Makefile "$CK/toolchain.Makefile" 2>/dev/null || true
        cp friendlywrt/include/version.mk "$CK/version.mk" 2>/dev/null || true
        find friendlywrt/target/linux/rockchip/patches-6.12 -type f 2>/dev/null | \
          sort | xargs md5sum 2>/dev/null | md5sum > "$CK/patches.md5" || echo "none" > "$CK/patches.md5"
        find friendlywrt/target/linux/generic/patches-6.12 -type f 2>/dev/null | \
          sort | xargs md5sum 2>/dev/null | md5sum > "$CK/generic-patches.md5" || echo "none" > "$CK/generic-patches.md5"
        ls -la "$CK/"

    - name: Setup month key
      id: mk
      run: echo "ym=$(date +%Y-%m)" >> "$GITHUB_OUTPUT"

    - name: Restore staging_dir
      id: staging_restore
      uses: actions/cache@v4
      with:
        path: project/friendlywrt/staging_dir
        key: staging-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-${{ hashFiles('.cache-key/**') }}
        restore-keys: |
          staging-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-
          staging-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-

    - name: Restore ccache
      uses: actions/cache@v4
      with:
        path: ~/.ccache
        key: ccache-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-${{ steps.mk.outputs.ym }}
        restore-keys: |
          ccache-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-
          ccache-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-

    - name: Restore downloads (dl)
      uses: actions/cache@v4
      with:
        path: project/friendlywrt/dl
        key: dl-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ steps.mk.outputs.ym }}
        restore-keys: |
          dl-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-

    - name: Restore Go module cache
      uses: actions/cache@v4
      with:
        path: /tmp/go-mod-cache
        key: gomod-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ steps.mk.outputs.ym }}
        restore-keys: |
          gomod-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-

    - name: Run custom kernel config & build
      env:
        ROOTFS_PARTSIZE: ${{ env.ROOTFS_PARTSIZE }}
        CCACHE_DIR: ${{ env.CCACHE_DIR }}
        IMMORTALWRT: '1'
      run: bash scripts/custome_kernel_config_new.sh

    - name: Save staging_dir cache
      if: always() && steps.staging_restore.outputs.cache-hit != 'true'
      uses: actions/cache/save@v4
      with:
        path: project/friendlywrt/staging_dir
        key: staging-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-${{ hashFiles('.cache-key/**') }}-r${{ github.run_id }}

    - name: Save ccache
      if: always()
      uses: actions/cache/save@v4
      with:
        path: ~/.ccache
        key: ccache-${{ env.CACHE_VERSION }}-${{ env.IMMORTALWRT_BRANCH }}-${{ env.FLAVOR }}-${{ steps.mk.outputs.ym }}-r${{ github.run_id }}

    - name: Clean go-mod-cache and show stats
      if: always()
      run: |
        rm -rf project/friendlywrt/dl/go-mod-cache
        ccache -s || true
        du -sh "$CCACHE_DIR" project/friendlywrt/staging_dir project/friendlywrt/dl 2>/dev/null || true

    - name: Locate kernel artifacts
      run: |
        cd project/friendlywrt

        TRIPLE_DIR=$(find build_dir -maxdepth 1 -type d -name "target-*_musl" | head -1)
        [ -z "$TRIPLE_DIR" ] && { echo "::error::target triple not found"; exit 1; }
        TRIPLE_DIR=$(realpath "$TRIPLE_DIR")
        echo "TRIPLE_DIR=$TRIPLE_DIR" >> $GITHUB_ENV

        KDIR=$(find "$TRIPLE_DIR" -maxdepth 1 -type d -name "linux-rockchip*" | head -1)
        [ -z "$KDIR" ] && { echo "::error::linux-rockchip dir not found"; exit 1; }
        KDIR=$(realpath "$KDIR")
        echo "KDIR=$KDIR" >> $GITHUB_ENV

        IMG=$(find "$KDIR" -path "*/arch/arm64/boot/Image" -type f 2>/dev/null | head -1)
        [ -z "$IMG" ] && IMG=$(find "$KDIR" -maxdepth 4 -name "Image" -type f 2>/dev/null | head -1)
        [ -z "$IMG" ] && { echo "::error::Kernel Image not found"; exit 1; }
        IMG=$(realpath "$IMG")
        echo "IMAGE_PATH=$IMG" >> $GITHUB_ENV

        DTB_DIR=$(find "$KDIR" -path "*/arch/arm64/boot/dts/rockchip" -type d 2>/dev/null | head -1)
        [ -z "$DTB_DIR" ] && { echo "::error::DTB dir not found"; exit 1; }
        DTB_DIR=$(realpath "$DTB_DIR")
        echo "DTB_DIR=$DTB_DIR" >> $GITHUB_ENV

        ROOTFS_SRC=$(find "$TRIPLE_DIR" -maxdepth 1 -type d -name "root-*" | head -1)
        [ -z "$ROOTFS_SRC" ] && { echo "::error::Rootfs dir not found"; exit 1; }
        ROOTFS_SRC=$(realpath "$ROOTFS_SRC")
        echo "ROOTFS_SRC=$ROOTFS_SRC" >> $GITHUB_ENV

        KV=$(ls "$ROOTFS_SRC/lib/modules/" 2>/dev/null | head -1)
        echo "KV=$KV" >> $GITHUB_ENV
        case "$KV" in
          6.12*) echo "[OK] 内核 6.12" ;;
          *)     echo "::warning::内核版本 $KV" ;;
        esac

    - name: Clone sd-fuse_rk3568
      run: |
        cd project
        rm -rf sd-fuse
        git clone --depth 1 https://github.com/friendlyarm/sd-fuse_rk3568.git sd-fuse
        cd sd-fuse
        [ -f mk-emmc-image.sh ] || { echo "::error::mk-emmc-image.sh missing"; exit 1; }

    - name: Package kernel
      run: |
        cd project
        SF="sd-fuse"
        TGT="$SF/$TARGET_OS"
        mkdir -p "$TGT"
        "$SF/tools/mkkrnlimg" "$IMAGE_PATH" "$TGT/kernel.img"
        cp "$TGT/kernel.img" "$TGT/boot.img"
        ls -lh "$TGT/kernel.img"

    - name: Package resource.img
      run: |
        cd project
        SF="$PWD/sd-fuse"
        TGT="$SF/$TARGET_OS"
        IMGFILE="$TGT/resource.img"
        mkdir -p "$TGT"

        rm -rf /tmp/dtb-pack
        mkdir -p /tmp/dtb-pack

        R5S_DTB=""
        for cand in rk3568-nanopi-r5s.dtb rk3568-nanopi-r5s-lts.dtb rk3568-nanopi-r5c.dtb; do
          [ -f "$DTB_DIR/$cand" ] && { R5S_DTB="$cand"; break; }
        done
        [ -z "$R5S_DTB" ] && { echo "::error::找不到 rk3568-nanopi-r5s*.dtb"; exit 1; }

        cp "$DTB_DIR/$R5S_DTB" /tmp/dtb-pack/rk-kernel.dtb
        for cand in rk3568-nanopi-r5s.dtb rk3568-nanopi-r5s-lts.dtb rk3568-nanopi-r5c.dtb; do
          [ -f "$DTB_DIR/$cand" ] && cp "$DTB_DIR/$cand" /tmp/dtb-pack/
        done

        cd /tmp/dtb-pack
        DTB_LIST=$(find . -maxdepth 1 -type f -name "*.dtb" -printf "%f\n" | sort)
        "$SF/tools/resource_tool" --pack --root=. --image="$IMGFILE" $DTB_LIST
        cd - > /dev/null
        ls -lh "$IMGFILE"

    - name: Stage U-Boot binaries
      run: |
        cd project/sd-fuse
        TGT="$TARGET_OS"
        for f in uboot.img idbloader.img MiniLoaderAll.bin misc.img dtbo.img; do
          [ -f "prebuilt/$f" ] && cp -v "prebuilt/$f" "$TGT/$f"
        done

    - name: Build rootfs.img
      run: |
        cd project/sd-fuse
        TGT="$TARGET_OS"

        rm -rf /tmp/rootfs-pack
        cp -a "$ROOTFS_SRC" /tmp/rootfs-pack
        (cd /tmp/rootfs-pack/dev && find . ! -type d -exec rm -f {} \; ) 2>/dev/null || true

        MKFS="$PWD/tools/mke2fs"
        MKFS_CONF="$PWD/tools/mke2fs.conf"
        ROOTFS_DIR=/tmp/rootfs-pack

        ACTUAL_MB=$(du -sm "$ROOTFS_DIR" | awk '{print $1}')
        echo "rootfs: ${ACTUAL_MB}MB / 目标 ${ROOTFS_PARTSIZE}MB"
        [ "$ACTUAL_MB" -gt "$ROOTFS_PARTSIZE" ] && { echo "::error::rootfs 过大"; exit 1; }

        LOGICAL_SIZE=$(( ROOTFS_PARTSIZE * 1024 * 1024 ))
        IMG_BLK=$(( LOGICAL_SIZE / 4096 ))
        INODE_SIZE=$(( $(find "$ROOTFS_DIR" | wc -l) + 128 ))

        rm -f "$TGT/rootfs.img"
        MKE2FS_CONFIG="$MKFS_CONF" \
          "$MKFS" -N "$INODE_SIZE" \
            -E android_sparse -t ext4 -L rootfs -M /root -b 4096 -0 \
            -d "$ROOTFS_DIR" "$TGT/rootfs.img" "$IMG_BLK"

        ls -lh "$TGT/rootfs.img"
        echo "ROOTFS_SIZE_BYTES=$LOGICAL_SIZE" >> $GITHUB_ENV

    - name: Generate parameter.txt
      run: |
        cd project/sd-fuse
        PARAMETER_TPL="$PWD/prebuilt/parameter.template" \
          ./tools/generate-partmap-txt.sh "$ROOTFS_SIZE_BYTES" "$TARGET_OS"

    - name: Patch parameter.txt CMDLINE
      run: |
        cd project/sd-fuse
        PARAM="$TARGET_OS/parameter.txt"
        REQUIRED_KW="cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"
        ADD=""
        for kw in $REQUIRED_KW; do
          grep -q -- "$kw" "$PARAM" || ADD="$ADD $kw"
        done
        ADD=$(echo "$ADD" | sed 's/^ *//;s/ *$//')
        [ -n "$ADD" ] && sed -i "/^CMDLINE[:=]/ s|$| $ADD|" "$PARAM"
        for kw in $REQUIRED_KW; do
          grep -q -- "$kw" "$PARAM" || { echo "::error::参数 $kw 未写入"; exit 1; }
        done

    - name: Build SD card image
      run: |
        cd project/sd-fuse
        export SDFUSE_NONINTERACTIVE=y
        sudo -E ./mk-sd-image.sh "$TARGET_OS" 2>&1 | tee /tmp/sd-image.log | tail -40 || true
        grep -q "more than capacity" /tmp/sd-image.log && { echo "::error::rootfs 未写入"; exit 1; }
        ls -lh out/

    - name: Build eMMC flasher image
      run: |
        cd project/sd-fuse
        export SDFUSE_NONINTERACTIVE=y
        sudo -E ./mk-emmc-image.sh "$TARGET_OS" autostart=yes > /tmp/emmc-image.log 2>&1 || true
        [ -f "out/emmc-flasher-images.tgz" ] || { echo "::error::emmc-flasher-images.tgz 未生成"; exit 1; }
        ls -lh out/emmc-flasher-images.tgz

    - name: Fix file ownership
      run: |
        cd project/sd-fuse
        [ -d "out" ] && sudo chown -R "$(id -u):$(id -g)" out/ 2>/dev/null || true
        [ -d "$TARGET_OS" ] && sudo chown -R "$(id -u):$(id -g)" "$TARGET_OS" 2>/dev/null || true

    - name: Rename artifacts
      run: |
        cd project/sd-fuse

        SRC_IMG=$(find out -maxdepth 1 -name "*.img" -type f 2>/dev/null | head -1)
        SRC_SIZE_MB=$(( $(stat -c%s "$SRC_IMG") / 1024 / 1024 ))
        [ "$SRC_SIZE_MB" -lt 400 ] && { echo "::error::SD 镜像只有 ${SRC_SIZE_MB}MB"; exit 1; }

        cp "$SRC_IMG" "/tmp/${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.img"
        gzip -f "/tmp/${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.img"
        cp "/tmp/${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.img.gz" ../../artifact/

        SRC_TGZ=$(find out -maxdepth 3 -name "*-images.tgz" -type f 2>/dev/null | head -1)
        [ -n "$SRC_TGZ" ] && cp "$SRC_TGZ" "../../artifact/images-${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.tgz"

        IMM_SYSUP=$(find ../friendlywrt/bin/targets/rockchip/armv8 -maxdepth 1 \
          -name "*nanopi-r5s*sysupgrade.img.gz" -type f 2>/dev/null | head -1)
        [ -n "$IMM_SYSUP" ] && cp "$IMM_SYSUP" "../../artifact/${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}-sysupgrade.img.gz"

        IMM_MANIFEST=$(find ../friendlywrt/bin/targets/rockchip/armv8 -maxdepth 1 \
          -name "*nanopi-r5s*.manifest" -type f 2>/dev/null | head -1)
        [ -n "$IMM_MANIFEST" ] && cp "$IMM_MANIFEST" "../../artifact/"

    - name: Generate SHA256 and README
      run: |
        cd artifact
        rm -f SHA256SUMS
        for f in *; do
          [ -f "$f" ] && [ "$f" != "SHA256SUMS" ] && sha256sum "$f" >> SHA256SUMS
        done

        cat > README.txt <<EOF
        ImmortalWrt for NanoPi R5S — $(date +%Y-%m-%d)
        发行标签: ${{ needs.prepare_release.outputs.release_tag }}
        内核: 6.12.x | rootfs: ${ROOTFS_PARTSIZE}MB | Docker + 晶晨宝盒
        默认密码: tony | 网关: 192.168.3.3

        产物:
        - ${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.img.gz      SD 卡镜像
        - images-${MODEL_NAME}-ImmortalWrt-${FRIENDLY_VER}.tgz  eMMC 刷机包
        - *-sysupgrade.img.gz                                   原生升级镜像
        - diagnostics.tgz                                       编译期诊断

        刷机后:
        - uname -r              → 6.12.x
        - ls /sys/class/leds/   → green:lan-1 green:lan-2 green:wan red:power
        - docker info           → 正常
        EOF
        ls -lh

    - name: Collect diagnostics
      if: always()
      run: |
        mkdir -p artifact/diagnostics
        DIAG=artifact/diagnostics

        [ -d "project/friendlywrt/.debug-artifacts" ] && \
          cp -r project/friendlywrt/.debug-artifacts/* "$DIAG/" 2>/dev/null || true

        if [ -n "$KDIR" ] && [ -d "$KDIR" ]; then
          KSRC_REAL=$(find "$KDIR" -maxdepth 1 -type d -name "linux-6.12*" | head -1)
          if [ -n "$KSRC_REAL" ] && [ -d "$KSRC_REAL" ]; then
            find "$KSRC_REAL" -name "rk3568-nanopi-r5s*.dts*" -type f -exec cp {} "$DIAG/" \; 2>/dev/null || true
            [ -f "$KSRC_REAL/.config" ] && {
              cp "$KSRC_REAL/.config" "$DIAG/kernel.config.full"
              grep -E "^CONFIG_(LEDS|GPIO|PINCTRL|R8169|STMMAC|NEW_LEDS|OF_GPIO|GPIOLIB|INET_DIAG)" \
                "$KSRC_REAL/.config" > "$DIAG/kernel-config-led-net.txt" || true
            }
            [ -f "$KSRC_REAL/System.map" ] && {
              cp "$KSRC_REAL/System.map" "$DIAG/"
              grep -E " (T|t) _?(leds_gpio_probe|led_gpio_set|led_classdev_register|ledtrig_netdev_activate|ledtrig_heartbeat_activate|rockchip_gpio_probe|r8169_probe|stmmac_dvr_probe|dwmac_rk_probe)$" \
                "$KSRC_REAL/System.map" > "$DIAG/System.map.leds-net" || true
            }
            [ -f "$KSRC_REAL/vmlinux" ] && cp "$KSRC_REAL/vmlinux" "$DIAG/" 2>/dev/null || true
          fi
        fi

        if [ -n "$ROOTFS_SRC" ] && [ -d "$ROOTFS_SRC" ]; then
          for f in \
            "$ROOTFS_SRC/etc/config/network" \
            "$ROOTFS_SRC/etc/init.d/led-force" \
            "$ROOTFS_SRC/etc/uci-defaults/50-fix-network"; do
            [ -f "$f" ] && cp "$f" "$DIAG/$(basename "$f").txt" || true
          done

          [ -d "$ROOTFS_SRC/etc/board.d" ] && \
            find "$ROOTFS_SRC/etc/board.d" -maxdepth 1 -type f -exec cp {} "$DIAG/" \; 2>/dev/null || true
        fi

        cd artifact
        tar czf diagnostics.tgz diagnostics/
        rm -rf diagnostics/
        ls -lh diagnostics.tgz

    - name: Upload all artifacts to release
      uses: svenstaro/upload-release-action@v2
      with:
        repo_token: ${{ secrets.GITHUB_TOKEN }}
        file: ./artifact/*
        tag: ${{ needs.prepare_release.outputs.release_tag }}
        overwrite: true
        file_glob: true

  cleanup_self:
    name: Cleanup Self Workflow History
    runs-on: ubuntu-latest
    needs: [prepare_release, build]
    if: ${{ always() }}
    permissions:
      actions: write
      contents: read
    steps:
      - name: Delete old workflow runs
        uses: Mattraks/delete-workflow-runs@v2
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          keep_minimum_runs: 0
          retain_days: 0
          delete_workflow_pattern: "Build ImmortalWrt for NanoPi R5S"
          repository: ${{ github.repository }}
